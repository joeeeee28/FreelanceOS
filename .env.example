# FreelanceOS environment variables
#
# Copy this file to .env.local (or .env) and fill in real values.
# NEVER commit the filled-in file — .env* is git-ignored except this example.
#
# All four variables are validated by src/lib/env.ts on first use at RUNTIME.
# The server fails immediately and loudly if any is missing or malformed.
#
# `next build` does NOT require them: the build must be reproducible without
# production credentials or a live database.

# ---------------------------------------------------------------------------
# DATABASE (Supabase PostgreSQL)
# ---------------------------------------------------------------------------
# Supabase exposes two different connection strings. Both are required and
# they are NOT interchangeable.
#
# DATABASE_URL = POOLED connection (Supavisor / PgBouncer, port 6543).
#   Used by the running application for normal queries. Because the pooler is
#   in transaction mode, Prisma needs the pgbouncer flag.
#   Supabase dashboard: Project Settings -> Database -> Connection string ->
#   "Transaction pooler".
#
#   Format:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL = DIRECT / session connection (port 5432).
#   Used ONLY by Prisma Migrate (`prisma migrate dev`, `prisma migrate deploy`).
#   Migrations cannot run through the transaction pooler.
#   Supabase dashboard: Project Settings -> Database -> Connection string ->
#   "Direct connection" (or the "Session pooler" on port 5432).
#
#   Format:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---------------------------------------------------------------------------
# AUTHENTICATION
# ---------------------------------------------------------------------------
# Secret used to sign session JWTs (HS256). MUST be at least 32 characters.
# Generate one with:  openssl rand -base64 48
# Rotating this value invalidates every existing session.
AUTH_SECRET="GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"

# ---------------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------------
# Absolute base URL of this deployment, including the scheme.
# Local:      http://localhost:3000
# Production: https://<your-service>.onrender.com
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# TESTING (optional)
# ---------------------------------------------------------------------------
# Disposable PostgreSQL used by `npm test`. The suite DROPS AND RECREATES the
# `public` schema on every run, so this must never point at production or
# Supabase — the helper refuses any non-local host.
# Defaults to the value below when unset.
# TEST_DATABASE_URL="postgresql://devuser:devpass@127.0.0.1:55432/freelanceos_dev"

# ---------------------------------------------------------------------------
# WORKER (background worker service only)
# ---------------------------------------------------------------------------
# Stable identity for the worker process. It is written to the logs, stored on
# each claimed job as the lease holder, and used as the primary key of this
# worker's heartbeat row (`WorkerHeartbeat`), which the Automation page reads to
# answer "is anything actually running?".
#
# Optional: the process falls back to `worker-<pid>`. Two worker instances must
# NOT share a value — the heartbeat row is keyed by it.
# WORKER_ID="freelanceos-worker"

# ---------------------------------------------------------------------------
# NETWORKING (optional)
# ---------------------------------------------------------------------------
# Number of trusted reverse proxies that append to `x-forwarded-for`. Used to
# pick the real client IP for rate limiting. Render sits behind 1 proxy.
# Set to 0 only if the app is exposed directly with no proxy in front.
# TRUSTED_PROXY_HOPS="1"
