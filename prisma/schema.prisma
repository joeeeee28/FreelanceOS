generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AppInit {
  id          Int      @id @default(1)
  initialized Boolean  @default(false)
  workspaceId String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Workspace {
  id              String   @id @default(cuid())
  name            String
  defaultCurrency String   @default("INR")
  country         String?
  timezone        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users      User[]
  setting    Setting?
  leads      Lead[]
  contacts   Contact[]
  activities Activity[]
  tasks      Task[]
  followUps  FollowUp[]
}

model Setting {
  id                String    @id @default(cuid())
  workspaceId       String    @unique
  taxPercentDefault Int       @default(0)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model User {
  id           String    @id @default(cuid())
  workspaceId  String
  email        String    @unique
  name         String?
  passwordHash String
  role         String    @default("OWNER")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions   Session[]
  activities Activity[]
  tasks      Task[]

  @@index([workspaceId])
}

model Session {
  id String @id @default(cuid())

  userId String

  /// SHA-256 digest of the session bearer token. The raw token is only ever
  /// held by the browser in an HTTP-only cookie and is never persisted, so a
  /// read-only disclosure of this table yields no usable credentials.
  tokenHash String @unique

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum LeadStatus {
  NEW
  RESEARCHING
  QUALIFIED
  OUTREACH_READY
  CONTACTED
  RESPONDED
  DISCOVERY_CALL
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  NURTURE
}

enum ActivityType {
  LEAD_CREATED
  LEAD_UPDATED
  RESEARCH_COMPLETED
  CONTACT_ADDED
  STATUS_CHANGED
  NOTE_ADDED
  EMAIL_SENT
  LINKEDIN_MESSAGE
  INSTAGRAM_MESSAGE
  FACEBOOK_MESSAGE
  WHATSAPP_MESSAGE
  PHONE_CALL
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_COMPLETED
  TASK_CREATED
  TASK_COMPLETED
  DISCOVERY_CALL
  PROPOSAL_SENT
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FollowUpChannel {
  EMAIL
  LINKEDIN
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  PHONE
  UPWORK
  FIVERR
  CONTRA
  COLD_EMAIL
  REFERRAL
  OTHER
}

enum FollowUpSequence {
  INITIAL
  FU1
  FU2
  FU3
  NURTURE
}

enum FollowUpStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Lead {
  id          String @id @default(cuid())
  workspaceId String

  companyName String
  contactName String?

  status LeadStatus @default(NEW)
  source String?

  website String?
  email   String?
  phone   String?

  country     String?
  city        String?
  industry    String?
  companySize String?

  linkedinUrl  String?
  instagramUrl String?
  facebookUrl  String?

  websitePresent Boolean?
  websiteQuality String?

  advertisingActivity String?
  contentActivity     String?

  serviceInterest String?
  painPoint       String?

  decisionMakerIdentified Boolean @default(false)
  qualificationNotes      String?

  score Int @default(0)

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts   Contact[]
  activities Activity[]
  tasks      Task[]
  followUps  FollowUp[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, score])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, deletedAt])
}

model Contact {
  id          String @id @default(cuid())
  workspaceId String
  leadId      String

  firstName String?
  lastName  String?
  fullName  String

  jobTitle String?
  email    String?
  phone    String?

  linkedinUrl String?

  isDecisionMaker Boolean @default(false)
  isPrimary       Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  activities Activity[]
  tasks      Task[]
  followUps  FollowUp[]

  @@index([workspaceId])
  @@index([leadId])
  @@index([workspaceId, email])
}

model Activity {
  id          String @id @default(cuid())
  workspaceId String
  leadId      String?
  contactId   String?

  type        ActivityType
  title       String
  description String?
  metadata    Json?

  createdByUserId String
  createdAt       DateTime @default(now())

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead          Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdByUser User      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, type])
  @@index([leadId])
  @@index([contactId])
}

model Task {
  id          String @id @default(cuid())
  workspaceId String

  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  dueAt       DateTime?
  completedAt DateTime?

  leadId    String?
  contactId String?

  createdByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead          Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdByUser User      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, dueAt])
  @@index([workspaceId, priority])
  @@index([leadId])
  @@index([contactId])
}

model FollowUp {
  id          String @id @default(cuid())
  workspaceId String
  leadId      String
  contactId   String?

  channel  FollowUpChannel
  sequence FollowUpSequence

  scheduledAt DateTime
  status      FollowUpStatus @default(SCHEDULED)

  message     String?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, scheduledAt])
  @@index([leadId])
  @@index([contactId])
}
